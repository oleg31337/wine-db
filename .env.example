# wine-db configuration — copy to .env and edit.
#
#   cp .env.example .env
#   openssl rand -base64 48        # -> SECRET_KEY
#   openssl rand -base64 24        # -> POSTGRES_PASSWORD
#
# Everything the backend needs lives here. The web interface never sees or sets
# any of it.

# ---------------------------------------------------------------- required
# Signs session cookies. Must be >= 32 characters. Changing it logs everyone out.
SECRET_KEY=

# Database password (the database is never published outside the compose network).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- web exposure
# The port your reverse proxy forwards to. Keep the bind on loopback unless the
# host itself is already firewalled.
WEB_PORT=8080
WEB_BIND=127.0.0.1

# Host header allow-list, comma separated (e.g. wine.example.com). "*" accepts any.
TRUSTED_HOSTS=*

# Session lifetime in minutes (720 = 12 hours).
SESSION_TTL_MINUTES=720

# Leave true when served over HTTPS (the normal case behind a proxy). Set false
# only for a plain-HTTP LAN test, otherwise browsers will discard the cookie.
COOKIE_SECURE=true

# ---------------------------------------------------------------- accounts
# Public self-registration is OFF. The single administrator is seeded from the
# environment below and is the ONLY account that can create/remove users and
# manage database import/export. Generate the hash with:
#   python -m app.tools.admin_hash "your-admin-password"
# Then paste the printed argon2... string here. In production the app refuses to
# start if either is missing. (Development auto-generates a random admin if unset.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# (Legacy) open registration / invitation code — kept for advanced self-hosting
# but disabled by default. Leave empty to keep accounts admin-only.
ALLOW_OPEN_REGISTRATION=false
REGISTRATION_CODE=

# ---------------------------------------------------------------- database
POSTGRES_DB=winedb
POSTGRES_USER=wine
# Host folder for the Postgres data directory (bind-mounted into the container).
# Everything here IS your database + users - back it up. Defaults to ./pgdata.
PG_DATA_DIR=./pgdata

# ---------------------------------------------------------------- app data
# Host folder for app state: uploaded label photos and backup exports.
# Defaults to ./data. This is the folder you back up. Never commit it (.gitignore).
DATA_DIR=./data

# ---------------------------------------------------------------- label reading
# Vision model reads label photos. It is an OpenAI-compatible chat-completions
# endpoint - this covers both hosted APIs (OpenAI, etc.) and local Ollama.
# Ollama exposes an OpenAI-compatible shim, so point VISION_BASE_URL straight at
# the Ollama host (no /v1 suffix needed); the app appends /v1/chat/completions.
VISION_BASE_URL=http://192.168.1.222:11434
VISION_API_KEY=
# Must be a model that accepts images.
VISION_MODEL=qwen2.5vl:latest
# Optional: a text-only model for the "fill from general knowledge" step.
# Defaults to VISION_MODEL when empty.
TEXT_MODEL=

# Summary model turns raw web-search text into structured fields. It can be a
# DIFFERENT provider from the vision model (e.g. a hosted API) - set
# SUMMARY_BASE_URL + optional SUMMARY_API_KEY. When empty, it reuses
# VISION_BASE_URL (the common single-endpoint setup).
SUMMARY_MODEL=nemotron-3-nano:4b
SUMMARY_BASE_URL=
SUMMARY_API_KEY=

AI_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------- internet lookup
# Web search enriches scanned/typed wines with real internet data. The default
# provider is DuckDuckGo's HTML endpoint (no key, no extra service). If you run
# a self-hosted SearXNG instance, set WEB_SEARCH_PROVIDER=searxng and its URL.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
# Optional self-hosted SearXNG instance with the JSON API enabled.
SEARXNG_BASE_URL=
# Open Food Facts is used ONLY for barcode lookups (barcoded products).
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org

# ---------------------------------------------------------------- limits
# Photo upload ceiling (8 MiB) and backup import ceiling (512 MiB).
MAX_UPLOAD_BYTES=8388608
MAX_BACKUP_BYTES=536870912

# Per-client-IP request budgets, per minute.
RATE_LIMIT_LOGIN_PER_MINUTE=8
RATE_LIMIT_API_PER_MINUTE=240
RATE_LIMIT_AI_PER_MINUTE=12
